<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_dark"
    android:padding="14dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="SweldoPulse"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="8dp"
            android:paddingRight="6dp">

            <TextView
                android:id="@+id/widget_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SweldoPulse"
                android:textColor="#F5F7FA"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/widget_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current cutoff"
                android:textColor="#76839A"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end"/>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_eye_btn"
            android:layout_width="34dp"
            android:layout_height="30dp"
            android:layout_marginRight="6dp"
            android:background="@drawable/widget_strip_dark"
            android:gravity="center"
            android:text="HIDE"
            android:textColor="#B6C0D0"
            android:textSize="8.5sp"
            android:textStyle="bold"/>

        <FrameLayout
            android:id="@+id/widget_add_btn"
            android:layout_width="32dp"
            android:layout_height="32dp">
            <ImageView
                android:id="@+id/widget_add_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_btn_bg"
                android:contentDescription="Log shift"/>
            <TextView
                android:id="@+id/widget_add_txt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"/>
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_net"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="P0.00"
        android:textColor="#F5F7FA"
        android:textSize="24sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/widget_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Open app to sync shifts"
        android:textColor="#A5B4FC"
        android:textSize="11sp"
        android:singleLine="true"
        android:ellipsize="end"/>
</LinearLayout>
