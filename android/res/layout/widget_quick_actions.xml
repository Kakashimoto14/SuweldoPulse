<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qa_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg_dark"
    android:padding="8dp"
    android:gravity="center_vertical">

    <FrameLayout
        android:id="@+id/qa_shift"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginRight="6dp">
        <ImageView
            android:id="@+id/qa_shift_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_btn_bg"
            android:contentDescription="Log shift"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="+ Shift"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold"/>
    </FrameLayout>

    <TextView
        android:id="@+id/qa_bulk"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginRight="6dp"
        android:background="@drawable/widget_strip_dark"
        android:gravity="center"
        android:text="Bulk"
        android:textColor="#FFFFFF"
        android:textSize="11.5sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/qa_spend"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginRight="6dp"
        android:background="@drawable/widget_strip_dark"
        android:gravity="center"
        android:text="Spend"
        android:textColor="#FFFFFF"
        android:textSize="11.5sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/qa_dues"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_strip_dark"
        android:gravity="center"
        android:text="Dues"
        android:textColor="#FFFFFF"
        android:textSize="11.5sp"
        android:textStyle="bold"/>
</LinearLayout>
