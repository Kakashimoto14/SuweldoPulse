<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_dark"
    android:padding="15dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="SweldoPulse"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="9dp"
            android:paddingRight="6dp">

            <TextView
                android:id="@+id/widget_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SweldoPulse"
                android:textColor="#F4F7FB"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/widget_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current cutoff"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:singleLine="true"
                android:ellipsize="end"/>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_eye_btn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginRight="6dp"
            android:background="@drawable/widget_strip_dark"
            android:gravity="center"
            android:text="HIDE"
            android:textColor="#94A3B8"
            android:textSize="8.5sp"
            android:textStyle="bold"/>

        <FrameLayout
            android:id="@+id/widget_add_btn"
            android:layout_width="36dp"
            android:layout_height="36dp">
            <ImageView
                android:id="@+id/widget_add_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_btn_bg"
                android:contentDescription="Log shift"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"/>
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_net"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="P0.00"
        android:textColor="#FFFFFF"
        android:textSize="27sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/widget_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Open app to sync shifts"
        android:textColor="#A5B4FC"
        android:textSize="11.5sp"
        android:singleLine="true"
        android:ellipsize="end"/>

    <LinearLayout
        android:id="@+id/widget_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_strip_dark"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_gross_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gross"
                android:textColor="#94A3B8"
                android:textSize="9.5sp"/>
            <TextView
                android:id="@+id/widget_gross"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P0.00"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_ded_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deductions"
                android:textColor="#94A3B8"
                android:textSize="9.5sp"/>
            <TextView
                android:id="@+id/widget_ded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P0.00"
                android:textColor="#FB7185"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_extra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Tap card to open payslip"
        android:textColor="#94A3B8"
        android:textSize="10.5sp"
        android:singleLine="true"
        android:ellipsize="end"/>
</LinearLayout>
